# Copy to .env and fill in. Never commit .env. Generate tokens with:
#   uv run companion-api make-token
# Minimum 16 characters; the API refuses shorter ones.

# Client bearer tokens (one per device/session). The desk UI asks for the desk token once.
COMPANION_DESK_TOKEN=
COMPANION_ADMIN_TOKEN=

# Service-to-service token for a remote vault (only when vault.mode: remote).
COMPANION_VAULT_TOKEN=

# Home Assistant long-lived access token (Profile -> Security -> Long-lived access tokens).
COMPANION_HA_TOKEN=

# Gmail OAuth client (Desktop app type) - read-only scope. See docs/OPERATIONS.md#email.
COMPANION_GMAIL_CLIENT_ID=
COMPANION_GMAIL_CLIENT_SECRET=
# 32+ random bytes, base64 - encrypts stored OAuth refresh tokens at rest.
COMPANION_TOKEN_KEY=

# Optional: override config path / env file location.
# COMPANION_CONFIG=config/local.yaml
